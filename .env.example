# Local-only installation. No provider key is required when using a local model.
SYNAPSE_PORT=3000
# Use letters/numbers or URL-encode special characters in DATABASE_URL.
POSTGRES_PASSWORD=synapse

# Models are fetched automatically after connecting. Model variables are optional fallbacks.
# Choose a default model and change endpoints in Settings. Custom model IDs remain supported.
OPENAI_API_KEY=
OPENAI_MODELS=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
ANTHROPIC_API_BASE=
GEMINI_API_KEY=
GEMINI_MODELS=
GEMINI_API_BASE=
XAI_API_KEY=
XAI_MODELS=
XAI_API_BASE=

# Localhost is automatically routed to the host when Synapse runs in Docker.
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_MODELS=qwen3:8b
OLLAMA_API_BASE=
OLLAMA_MODELS=
OLLAMA_API_KEY=
# LMSTUDIO_API_BASE=http://localhost:1234
LMSTUDIO_API_BASE=
LMSTUDIO_MODELS=
LMSTUDIO_API_KEY=
